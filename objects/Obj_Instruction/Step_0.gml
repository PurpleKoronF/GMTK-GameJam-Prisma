RoomNameCheck=room_get_name(room);
if(RoomNameCheck="RM_MiniGameBaldi")
ButtonText="Count!";
if(RoomNameCheck="RM_MiniGameBomb")
ButtonText="Stop the count down!";
if(RoomNameCheck="RM_MiniGameCook")
ButtonText="Set the count down!";
if(RoomNameCheck="RM_MiniGameMetronome")
ButtonText="Match the count down!";
if(RoomNameCheck="RM_MiniGameSheeps")
ButtonText="Count them down!";
if(RoomNameCheck="RM_MiniGameSniper")
ButtonText="Count the downed!";

